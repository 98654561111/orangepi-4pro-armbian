; 12GB LPDDR5 DRAM config transplanted from Radxa Cubie A7A
; Source: https://github.com/radxa/allwinner-device
;         branch device-a733-v1.4.8, configs/cubie_a7a/sys_config.fex
;         section [dram_para3] ("cxmt 12g ddr")
; Verified bootable on Orange Pi 4 Pro 12GB by board owner.
[dram_para]
dram_clk = 1800
dram_type = 9
dram_dx_odt = 0x0e0e0e0e
dram_dx_dri = 0x0f0f0f0f
dram_ca_dri = 0xec030e0f
dram_para0 = 0
dram_para1 = 0xa11a
dram_para2 = 0x1001
dram_mr0 = 0
dram_mr1 = 0
dram_mr2 = 0
dram_mr3 = 0x6
dram_mr4 = 0
dram_mr5 = 0
dram_mr6 = 0
dram_mr11 = 0x12
dram_mr12 = 0x44
dram_mr13 = 0
dram_mr14 = 0x34
dram_mr16 = 0
dram_mr17 = 0x86
dram_mr22 = 0
dram_tpr0 = 0x4040
dram_tpr1 = 0
dram_tpr2 = 0x11080503
dram_tpr3 = 0x3800
dram_tpr6 = 0x3514
dram_tpr10 = 0xb25f0000
dram_tpr11 = 0
dram_tpr12 = 0
dram_tpr13 = 0x10065
dram_tpr14 = 0
